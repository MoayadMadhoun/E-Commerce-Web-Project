@page "{id}"
@model MyStore.Pages.Products.DeleteModel
@{
	ViewData["Title"] = "Product - Delete";
	Layout = "_NLayout";

}


<h2 class="text-danger mb-3"><i class="bi bi-trash3-fill text-danger"></i> Delete Product</h2>

<div class=" alert alert-warning">
	Are you sure you want to delete this product?
</div>

<div class="card mb-3 " style="max-width: 500px;">
	<div class="card-body">
		<img src="/@Model.Product.ImageUrl" class="img-fluid rounded mb-3"/>
		<h5 class="card-title">@Model.Product.Name</h5>
		<p class="card-text">
			Price: <strong>@Html.Raw(Model.Product.PriceStr)</strong> <br />
			Stock: <strong> @Model.Product.StockQuantity</strong>
		</p>
	</div>
</div>

<form method="post">

	<button type="submit" class="btn btn-secondary">
		<i class="bi bi-trach3-fill"></i> Yes, Delete
	</button>

	<a asp-page="Index" class="btn btn-secondary">
		Cancel
	</a>
</form>





