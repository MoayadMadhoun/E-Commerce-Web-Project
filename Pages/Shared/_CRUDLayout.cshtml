@using Microsoft.AspNetCore.Identity
@using MyStore.Models
@inject UserManager<AppUser> UserManager

@{
    AppUser user = null;

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        user = await UserManager.GetUserAsync(User);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - MyStore</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .sidebar {
            width: 260px;
            min-height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #111827;
            color: white;
        }

            .sidebar a {
                color: #fff;
                text-decoration: none;
            }

        .main-content {
            margin-left: 260px;
        }

        .topbar {
            height: 60px;
            background: white;
            border-bottom: 1px solid #eee;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar p-3">
        <h4 class="text-center mb-4">MyStore</h4>

        <div class="d-flex align-items-center mb-3">
            <img src="@(user?.ProfileImageUrl ?? "/assets/images/default.png")"
                 class="rounded-circle me-2" width="40" height="40" />
            <div>
                <div>@user?.FullName</div>
                <small class="text-muted">@user?.Email</small>
            </div>
        </div>

        <hr />

        <ul class="nav flex-column">
            <li class="nav-item mb-2">
                <a asp-page="/Index" class="nav-link">Home</a>
            </li>
            <li class="nav-item mb-2">
                <a asp-page="/Products/Index" class="nav-link">Products</a>
            </li>
            <li class="nav-item mb-2">
                <a asp-page="/Categories/Index" class="nav-link">Categories</a>
            </li>
            <li class="nav-item mb-2">
                <a asp-page="/Users/Index" class="nav-link">Users</a>
            </li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="main-content">

        <!-- Topbar -->
        <nav class="topbar d-flex justify-content-between align-items-center px-4">
            <div>
                <button class="btn btn-outline-secondary btn-sm" id="toggleSidebar">
                    <i class="bi bi-list"></i>
                </button>
            </div>

            <div class="dropdown">
                <a class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle"
                   href="#"
                   data-bs-toggle="dropdown">

                    <img src="@(user?.ProfileImageUrl ?? "/assets/images/default.png")"
                         class="rounded-circle me-2" width="35" height="35" />

                    @user?.FullName
                </a>

                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Profile</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Logout">Logout</a></li>
                </ul>
            </div>
        </nav>

        <!-- Page Content -->
        <div class="container-fluid p-4">
            @RenderBody()
        </div>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // simple sidebar toggle
        document.getElementById("toggleSidebar")?.addEventListener("click", function () {
            document.querySelector(".sidebar").classList.toggle("d-none");
            document.querySelector(".main-content").classList.toggle("ms-0");
        });
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>