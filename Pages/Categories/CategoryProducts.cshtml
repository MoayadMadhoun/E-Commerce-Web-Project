@page "{catId}"
@model MyStore.Pages.Categories.CategoryProductsModel
@{
	ViewData["Title"] = "Category - Products";
	Layout = "_NLayout";

}

<h2 class="mb-4 ">All products for the category: </h2>

<table class="table table-striped">
	<thead class="table-dark">
		<tr>
			<th>Images</th>
			<th>Name</th>
			<th>Prices</th>
			<th>Stock</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var p in Model.Products)
		{
			<tr>
				<td valign="middle">
					<img src="@p.ImageUrl" width="70" class="img-thumbnail" />
				</td>
				<td valign="middle">@p.Name</td>
				<td valign="middle">
					@Html.Raw(@p.PriceStr)
				</td>
				<td valign="middle"> @p.StockQuantity</td>
				<td valign="middle">
					<a asp-page="Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-warning"><i class="bi bi-pen"></i></a>
					<a asp-page="Delete" asp-route-id="@p.ProductId" class="btn btn-sm btn-danger"><i class="bi bi-trash3-fill"></i></a>
					<a asp-page="Products/Images" asp-route-productId="@p.ProductId" class="btn btn-sm btn-info"><i class="bi bi-images"></i></a>
				</td>
			</tr>
		}

	</tbody>
</table>